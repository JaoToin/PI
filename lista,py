#------------------------------------ busca binaria

listar = []
numero = int(input())

inicio = 0
fim = len(listar) - 1
achou = False
meio = None

while (inicio <= fim) & (not achou):
    meio = (inicio + fim ) // 2
    if numero < listar[meio]:
        fim = meio - 1 
    elif numero > listar[meio]:
        inicio = meio + 1 
    else:
        achou

